{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/work_log.py sessionStart"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/work_log.py beforeSubmitPrompt"
      }
    ],
    "afterAgentThought": [
      {
        "command": "python3 .cursor/hooks/work_log.py afterAgentThought"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/work_log.py afterFileEdit"
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python3 .cursor/hooks/work_log.py afterAgentResponse"
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/work_log.py stop",
        "loop_limit": 1
      }
    ],
    "sessionEnd": [
      {
        "command": "python3 .cursor/hooks/work_log.py sessionEnd"
      }
    ]
  }
}
